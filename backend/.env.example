PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/smart_farming
DIRECT_URL=postgresql://postgres:password@localhost:5432/smart_farming
MQTT_HOST=your-mqtt-broker-host
MQTT_PORT=8883
MQTT_PROTOCOL=mqtts
MQTT_USERNAME=replace-with-device-service-user
MQTT_PASSWORD=replace-with-a-secret
ENABLE_MQTT=0
MQTT_SENSOR_TOPICS=sf/+/sensor
MQTT_RELAY_TOPICS=sf/+/relay
MQTT_STATUS_TOPICS=sf/+/status
MQTT_COMMAND_TOPIC=sf/devices/relay/command
MQTT_ACK_TOPICS=sf/+/ack
MQTT_IRRIGATION_CONFIG_ACK_TOPICS=sf/+/config/irrigation/ack
DEVICE_ID=esp32-01
DEVICE_HEARTBEAT_INTERVAL_MS=120000
SOIL_DRY_ALERT_THRESHOLD_PERCENT=30
