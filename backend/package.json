{
  "name": "iot-backend",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "prisma generate && node src/index.js",
    "start:worker": "node src/mqtt-worker.js",
    "dev:worker": "node --watch src/mqtt-worker.js",
    "check": "node --check src/index.js && node --check src/mqtt-worker.js",
    "test": "node --test",
    "auth:bootstrap-admin": "node scripts/bootstrap-admin.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@prisma/client": "^6.14.0",
    "dotenv": "^16.4.5",
    "hono": "^4.9.4",
    "mqtt": "^5.14.0",
    "prisma": "^6.12.0",
    "zod": "^4.1.0"
  }
}
